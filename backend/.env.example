APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mindmesh
JWT_SECRET=replace-this-with-a-long-random-secret
# backend/.env
FRONTEND_ORIGIN=http://192.168.1.4:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.4:3000
ML_MODEL_DIR=../models

# Password-reset links require an approved email provider in production.
# Set true only during local development to receive a clearly marked reset URL
# in the API response; never enable this in a deployed environment.
PASSWORD_RESET_DEV_MODE=false
PASSWORD_RESET_TTL_MINUTES=30

# Sahaaya free-tier cloud voice mode. Create a free key at openrouter.ai/keys.
VOICE_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
# Comma-separated retries when a free model has no capacity.
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,inclusionai/ling-3.0-flash-vl:free

# Optional fully local Qwen mode: requires Ollama and a downloaded model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional OpenAI Realtime mode. Never add this key to frontend/.env.local.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
